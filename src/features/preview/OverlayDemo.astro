---
import { renderPreview } from './render-preview';
---

<div class="demo-shell">
  <div class="demo-top">
    <span><span class="live-dot"></span> PRÉVIA DO APP</span><span
      >AOE II · DE</span
    >
  </div>
  <div class="app-demo-stage">
    <div class="app-preview" data-layout="detailed">
      <iframe
        title="Overlay completo do MatchDeck com dados fictícios"
        srcdoc={renderPreview('detailed')}
        width="480"
        height="420"
        loading="eager"></iframe>
    </div>
    <div class="app-preview" data-layout="compact" hidden>
      <iframe
        title="Overlay compacto do MatchDeck com dados fictícios"
        srcdoc={renderPreview('compact')}
        width="720"
        height="120"
        loading="eager"></iframe>
    </div>
  </div>
  <div class="demo-controls">
    <span>Interface do app · dados fictícios</span><div
      role="group"
      aria-label="Modo de exibição"
    >
      <button type="button" data-mode="detailed" aria-pressed="true"
        >Completo</button
      ><button type="button" data-mode="compact" aria-pressed="false"
        >Compacto</button
      >
    </div>
  </div>
</div>
<script>
  const previews = document.querySelectorAll<HTMLElement>('.app-preview');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-mode]');
  function fitPreview(container: HTMLElement) {
    if (container.hidden) return;
    const frame = container.querySelector('iframe');
    if (!frame) return;
    const nativeWidth = Number(frame.getAttribute('width'));
    const height =
      frame.contentDocument?.body.scrollHeight ||
      Number(frame.getAttribute('height'));
    const scale = Math.min(1, container.clientWidth / nativeWidth);
    frame.style.height = `${height}px`;
    frame.style.marginLeft = `${(container.clientWidth - nativeWidth * scale) / 2}px`;
    frame.style.transform = `scale(${scale})`;
    container.style.height = `${height * scale}px`;
  }
  previews.forEach((container) => {
    const frame = container.querySelector('iframe');
    frame?.addEventListener('load', () => fitPreview(container));
    new ResizeObserver(() => fitPreview(container)).observe(container);
    fitPreview(container);
  });
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      previews.forEach((container) => {
        container.hidden = container.dataset.layout !== button.dataset.mode;
        fitPreview(container);
      });
      buttons.forEach((item) =>
        item.setAttribute('aria-pressed', String(item === button)),
      );
    }),
  );
</script>
