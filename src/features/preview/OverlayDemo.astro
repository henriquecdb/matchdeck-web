---
import { asset } from '../../config/site';
import provenance from '../../vendor/matchdeck/provenance.json';
---

<div class="demo-shell">
  <div class="demo-top">
    <span><span class="live-dot"></span> PRÉVIA DO APP</span><span
      >v{provenance.version}</span
    >
  </div>
  <div class="preview-settings">
    <label
      >Jogo<select id="preview-game"
        ><option value="aoe2-de">Age of Empires II: DE</option><option
          value="aoe4">Age of Empires IV · experimental</option
        ><option value="sc2">StarCraft II · Early Access</option></select
      ></label
    >
    <label data-format-control
      >Formato<select id="preview-teams"
        ><option value="1">1v1</option><option value="2">2v2</option><option
          value="3">3v3</option
        ><option value="4">4v4</option></select
      ></label
    >
    <label data-layout-control
      >Overlay<select id="preview-layout"
        ><option value="detailed">Completo</option><option value="compact"
          >Compacto horizontal</option
        ><option value="stacked">Compacto vertical</option></select
      ></label
    >
    <label
      >Momento<select id="preview-stage"
        ><option value="match">Durante a partida</option><option
          value="post-game">Pós-partida</option
        ></select
      ></label
    >
    <label data-result-control hidden
      >Resultado<select id="preview-result"
        ><option value="win">Vitória</option><option value="loss"
          >Derrota</option
        ><option value="draw">Empate</option></select
      ></label
    >
  </div>
  <div class="app-demo-stage">
    <div class="app-preview">
      <iframe
        id="app-preview-frame"
        title="Prévia do overlay do Age of Empires II com dados fictícios"
        src={asset('previews/aoe2-detailed-1.html')}
        width="480"
        height="468"
        loading="eager"></iframe>
    </div>
  </div>
  <p class="preview-note" id="preview-note" aria-live="polite">
    Interface original do app · dados fictícios. Sessão ilustrativa; o modo
    completo é exclusivo de 1v1.
  </p>
</div>
<script>
  import { asset } from '../../config/site';
  import {
    selectPreview,
    type PreviewLayout,
    type TeamSize,
    type PreviewStage,
    type PreviewResult,
  } from './preview-options';
  const game = document.querySelector<HTMLSelectElement>('#preview-game')!;
  const teams = document.querySelector<HTMLSelectElement>('#preview-teams')!;
  const layout = document.querySelector<HTMLSelectElement>('#preview-layout')!;
  const stage = document.querySelector<HTMLSelectElement>('#preview-stage')!;
  const result = document.querySelector<HTMLSelectElement>('#preview-result')!;
  const frame =
    document.querySelector<HTMLIFrameElement>('#app-preview-frame')!;
  const container = frame.parentElement!;
  const note = document.querySelector<HTMLElement>('#preview-note')!;
  const preferredLayouts: Record<string, PreviewLayout> = {
    'aoe2-de': 'detailed',
    aoe4: 'compact',
    sc2: 'compact',
  };
  function fitPreview() {
    const overlay = frame.contentDocument?.querySelector<HTMLElement>(
      '.age-session-overlay, .sc2-post-game, .sc2-overlay, .match-overlay, .linear-overlay, .aoe4-overlay',
    );
    if (!overlay) return;
    const nativeWidth = Number(frame.getAttribute('width'));
    const height = Math.ceil(overlay.getBoundingClientRect().height);
    const scale = Math.min(1, container.clientWidth / nativeWidth);
    frame.style.height = height + 'px';
    frame.style.marginLeft =
      (container.clientWidth - nativeWidth * scale) / 2 + 'px';
    frame.style.transform = 'scale(' + scale + ')';
    container.style.height = height * scale + 'px';
  }
  function updatePreview() {
    const option = selectPreview(
      game.value,
      preferredLayouts[game.value],
      Number(teams.value) as TeamSize,
      stage.value as PreviewStage,
      result.value as PreviewResult,
    );
    const isAoe2 = option.game === 'aoe2-de';
    const postGame = option.stage === 'post-game';
    document.querySelector<HTMLElement>('[data-format-control]')!.hidden =
      !isAoe2;
    document.querySelector<HTMLElement>('[data-layout-control]')!.hidden =
      postGame || option.game === 'sc2';
    document.querySelector<HTMLElement>('[data-result-control]')!.hidden =
      !postGame;
    layout.options[0].disabled = !isAoe2 || teams.value !== '1';
    layout.options[0].hidden = !isAoe2;
    if (!postGame) layout.value = option.layout;
    note.textContent = postGame
      ? 'Resumo original do app · resultado, duração e placar fictícios. No aplicativo, os dados dependem da confirmação da fonte ou do replay.'
      : option.game === 'sc2'
        ? 'SC2 Early Access · compacto com sessão ilustrativa. MMR ranqueado por raça; o cliente não confirma a fila. Dados fictícios.'
        : option.game === 'aoe4'
          ? 'Age IV experimental · 1v1 horizontal ou vertical, com sessão ilustrativa. Pontos ranqueados não são MMR. Dados fictícios.'
          : teams.value === '1'
            ? 'Interface original do app · dados fictícios. Sessão ilustrativa; o modo completo é exclusivo de 1v1.'
            : 'Interface original do app · dados fictícios. Em equipes, a preferência pelo completo usa o compacto vertical.';
    const gameName = game.selectedOptions[0].text;
    frame.title =
      'Prévia ' +
      (postGame ? 'do pós-partida' : 'do overlay') +
      ' · ' +
      gameName +
      ' · dados fictícios';
    frame.setAttribute('width', String(option.width));
    const src = asset('previews/' + option.id + '.html');
    if (frame.getAttribute('src') !== src) frame.src = src;
  }
  layout.addEventListener('change', () => {
    preferredLayouts[game.value] = layout.value as PreviewLayout;
    updatePreview();
  });
  for (const select of [game, teams, stage, result])
    select.addEventListener('change', updatePreview);
  frame.addEventListener('load', fitPreview);
  let measuredWidth = 0;
  new ResizeObserver(([entry]) => {
    if (entry.contentRect.width === measuredWidth) return;
    measuredWidth = entry.contentRect.width;
    requestAnimationFrame(fitPreview);
  }).observe(container);
  fitPreview();
</script>
