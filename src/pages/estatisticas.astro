---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import snapshotJson from '../../public/data/statistics.json';
import { enrichSnapshot } from '../features/statistics/catalog';
import {
  rankRows,
  freshness,
  type StatsSnapshot,
} from '../features/statistics/model';
import '../features/statistics/statistics.css';
const snapshot = enrichSnapshot(snapshotJson as StatsSnapshot);
const initial = snapshot.games.aoe2;
const rows = rankRows(initial.views[0].rows);
const number = new Intl.NumberFormat('pt-BR');
const percent = (value: number) =>
  value.toLocaleString('pt-BR', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }) + '%';
const date = (value: string) =>
  new Intl.DateTimeFormat('pt-BR', {
    dateStyle: 'short',
    timeStyle: 'short',
    timeZone: 'America/Sao_Paulo',
  }).format(new Date(value));
const total = initial.views[0].rows.reduce((sum, row) => sum + row.games, 0);
const popular = [...initial.views[0].rows].sort((a, b) => b.games - a.games)[0];
---

<BaseLayout
  title="Estatísticas de civilizações — MatchDeck"
  description="Ranking de civilizações do Age II e Age IV por winrate, partidas, vitórias, derrotas e popularidade. Consulte o recorte e a data dos dados."
>
  <SiteHeader statistics />
  <main id="conteudo" class="wrap stats-page">
    <div class="stats-heading">
      <div>
        <span class="eyebrow">O JOGO ALÉM DA PARTIDA</span><h1>
          Civilizações.<br /><span class="accent">Os números do confronto.</span
          >
        </h1><p>
          Explore o desempenho de cada civilização.<br />O contexto está na
          amostra, no nível dos jogadores e no patch.
        </p>
      </div><a class="text-link" href="#metodologia">Como ler estes dados ↓</a>
    </div>
    <div class="stats-tabs" role="tablist" aria-label="Jogo">
      <button
        id="tab-aoe2"
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="ranking-panel"
        data-game="aoe2">Age of Empires II <span>DE</span></button
      ><button
        id="tab-aoe4"
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="ranking-panel"
        tabindex="-1"
        data-game="aoe4">Age of Empires IV</button
      >
    </div>
    <section id="ranking-panel" role="tabpanel" aria-labelledby="tab-aoe2">
      <div class="data-warning" id="data-warning" role="status">
        {freshness(initial)}
      </div>
      <div class="stats-filters">
        <label
          ><span id="band-label">Faixa de Elo</span><select id="stats-band"
            >{
              initial.views.map((view) => (
                <option value={view.id}>{view.label}</option>
              ))
            }</select
          ></label
        ><label
          >Buscar civilização<input
            id="stats-search"
            type="search"
            placeholder="Ex.: Francos"
            autocomplete="off"
          /></label
        ><label
          >Amostra mínima<select id="stats-minimum"
            ><option value="0">Todas as amostras</option><option
              value="100"
              selected>100 partidas</option
            ><option value="1000">1.000 partidas</option><option value="10000"
              >10.000 partidas</option
            ></select
          ></label
        >
      </div>
      <div class="stats-kpis">
        <article>
          <span>MAIOR WINRATE NO RECORTE</span><strong id="kpi-best"
            >{rows[0].name}</strong
          ><small id="kpi-best-value"
            >{percent(rows[0].winRate)} · {number.format(rows[0].games)} participações</small
          >
        </article><article>
          <span>MAIS ESCOLHIDA NO RECORTE</span><strong id="kpi-popular"
            >{popular.name}</strong
          ><small id="kpi-popular-value"
            >{percent((100 * popular.games) / total)} das participações</small
          >
        </article><article>
          <span>TAMANHO DA AMOSTRA</span><strong id="kpi-sample"
            >{number.format(total)}</strong
          ><small id="kpi-civs"
            >participações · {initial.views[0].rows.length} civilizações</small
          >
        </article>
      </div>
      <div class="ranking-title">
        <h2>Ranking de civilizações</h2><p
          id="ranking-status"
          aria-live="polite"
        >
          {rows.length} civilizações · ordenado por winrate
        </p>
      </div>
      <div
        class="stats-table-scroll"
        tabindex="0"
        role="region"
        aria-label="Tabela de civilizações; em telas pequenas, role horizontalmente"
      >
        <table class="stats-table">
          <caption
            >Ranqueado 1v1 de PC. Partidas são participações com a civilização,
            não partidas únicas.</caption
          ><thead
            ><tr
              ><th scope="col">#</th><th scope="col" data-sort="name"
                ><button type="button">Civilização</button></th
              ><th scope="col" data-sort="winRate" aria-sort="descending"
                ><button type="button">Winrate ↓</button></th
              ><th scope="col" data-sort="games"
                ><button
                  type="button"
                  title="Participações de jogadores com esta civilização"
                  >Partidas</button
                ></th
              ><th scope="col" data-sort="wins"
                ><button type="button">Vitórias</button></th
              ><th scope="col" data-sort="losses"
                ><button type="button">Derrotas</button></th
              ><th scope="col">Popularidade</th></tr
            ></thead
          ><tbody id="ranking-body"
            >{
              rows.map((row, index) => (
                <tr>
                  <>
                    <td class="rank-number">{index + 1}</td>
                    <th scope="row">
                      <span class="civ-name">
                        <img
                          src={row.icon}
                          alt=""
                          width="28"
                          height="28"
                          loading="lazy"
                        />
                        {row.name}
                      </span>
                    </th>
                    <td>
                      <>
                        <span
                          class={`rate-value ${row.winRate >= 50 ? 'positive' : 'negative'}`}
                        >
                          {percent(row.winRate)}
                        </span>
                        <span class="rate-track">
                          <span style={`width:${row.winRate}%`} />
                        </span>
                      </>
                    </td>
                    <td>{number.format(row.games)}</td>
                    <td class="positive">{number.format(row.wins)}</td>
                    <td class="negative">{number.format(row.losses)}</td>
                    <td>{percent((100 * row.games) / total)}</td>
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div><p id="empty-ranking" class="empty-ranking" hidden>
        Nenhuma civilização atende a esses filtros. Tente reduzir a amostra
        mínima ou alterar a busca.
      </p>
      <noscript
        ><p>
          Ative JavaScript para trocar de jogo, filtrar e comparar. Acima está o
          ranking padrão do Age II com todos os Elos.
        </p></noscript
      >
      <section class="stats-comparison" aria-labelledby="comparison-title">
        <div>
          <span class="eyebrow">DOIS ESTILOS, O MESMO RECORTE</span><h2
            id="comparison-title"
          >
            Coloque lado a lado.
          </h2><p>
            Compare o desempenho agregado de duas civilizações. Estes números
            não são a chance de uma vencer a outra.
          </p>
        </div><div class="compare-pair">
          {
            [0, 1].map((index) => (
              <article>
                <>
                  <label for={`compare-${index}`}>
                    Civilização {index + 1}
                  </label>
                  <select id={`compare-${index}`}>
                    {rows.map((row, i) => (
                      <option value={row.id} selected={i === index}>
                        {row.name}
                      </option>
                    ))}
                  </select>
                  <div id={`compare-values-${index}`}>
                    <>
                      <strong>{percent(rows[index].winRate)}</strong>
                      <p>{number.format(rows[index].games)} participações</p>
                      <span>
                        {number.format(rows[index].wins)} V ·{' '}
                        {number.format(rows[index].losses)} D
                      </span>
                    </>
                  </div>
                </>
              </article>
            ))
          }
        </div>
      </section>
      <section
        class="stats-method"
        id="metodologia"
        aria-labelledby="method-title"
      >
        <div>
          <span class="eyebrow">TRANSPARÊNCIA PRIMEIRO</span><h2
            id="method-title"
          >
            Leia o recorte.<br /><span>Depois, o ranking.</span>
          </h2><p>
            Winrate = vitórias ÷ participações × 100. Derrotas = participações −
            vitórias, conforme o agregado da fonte. Popularidade considera as
            participações das civilizações mapeadas no recorte, antes da busca e
            da amostra mínima.
          </p><p>
            Mais winrate não significa necessariamente uma civilização mais
            forte. Amostras pequenas oscilam mais; o nível dos jogadores e a
            versão do jogo mudam a interpretação.
          </p>
        </div><div class="source-card">
          <dl>
            <div>
              <dt>Fonte</dt><dd>
                <a id="stats-source" href={initial.sourceUrl}
                  >{initial.sourceName} ↗</a
                >
              </dd>
            </div><div>
              <dt>Patch / recorte da fonte</dt><dd id="stats-patch">
                {initial.patch}
              </dd>
            </div><div>
              <dt>Início do período informado</dt><dd id="stats-period">
                {initial.periodStart || 'Não informado'}
              </dd>
            </div><div>
              <dt>Agregado gerado pela fonte</dt><dd id="stats-generated">
                {
                  initial.sourceUpdatedAt
                    ? date(initial.sourceUpdatedAt)
                    : 'Data não informada pela API'
                }
              </dd>
            </div><div>
              <dt>Última consulta bem-sucedida do MatchDeck</dt><dd
                id="stats-fetched"
              >
                {date(initial.fetchedAt)} · Brasília
              </dd>
            </div>
          </dl><ul id="stats-notes">
            {initial.notes.map((note) => <li>{note}</li>)}{
              initial.unmappedIds.length > 0 && (
                <li>
                  IDs sem civilização mapeada na fonte:{' '}
                  {initial.unmappedIds.join(', ')}.
                </li>
              )
            }
          </ul><a class="text-link" href={initial.endpoint} id="stats-endpoint"
            >Consultar dados originais ↗</a
          >
        </div>
      </section>
    </section>
  </main><footer class="stats-footer wrap">
    <a href={import.meta.env.BASE_URL}>← Conhecer o MatchDeck</a><span
      >Estatísticas comunitárias · sem afiliação com Microsoft ou World's Edge.</span
    >
  </footer>
  <script
    id="statistics-data"
    type="application/json"
    set:html={JSON.stringify(snapshot).replaceAll(
      '<',
      String.fromCharCode(92) + 'u003c',
    )}
  />
  <script>
    import '../features/statistics/client';
  </script>
</BaseLayout>
