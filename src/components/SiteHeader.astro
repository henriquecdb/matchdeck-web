---
import Brand from './Brand.astro';
import { asset, site } from '../config/site';
interface Props {
  statistics?: boolean;
  units?: boolean;
}
const { statistics = false, units = false } = Astro.props;
const home = import.meta.env.BASE_URL;
---

<header class="site-header wrap">
  <Brand /><nav aria-label="Navegação principal">
    <a href={`${home}#recursos`}>O app</a><a href={`${home}#jogos`}>Jogos</a><a
      href={asset('estatisticas/')}
      aria-current={statistics ? 'page' : undefined}>Estatísticas</a
    ><a href={asset('unidades/')} aria-current={units ? 'page' : undefined}
      >Unidades e counters</a
    ><a href={site.appRepository}>GitHub ↗</a>
  </nav><a href={`${home}#download`} class="button button-small"
    >Baixar o app <span aria-hidden="true">↓</span></a
  >
</header>
<nav class="mobile-resources wrap" aria-label="Guias do jogo">
  <a
    href={asset('estatisticas/')}
    aria-current={statistics ? 'page' : undefined}>Estatísticas</a
  >
  <a href={asset('unidades/')} aria-current={units ? 'page' : undefined}
    >Unidades e counters</a
  >
</nav>
